# ConX — variables d'environnement
# Copie ce fichier en .env et remplis les valeurs réelles.
# JAMAIS de .env commité — voir .gitignore.

# ─────────────────────────────────────────────────────────
# PostgreSQL local (Docker, données publiques massives)
# ─────────────────────────────────────────────────────────
POSTGRES_LOCAL_HOST=postgres_local
POSTGRES_LOCAL_PORT=5432              # port interne (réseau Docker)
POSTGRES_LOCAL_PORT_HOST=5433         # port mappé sur l'hôte (évite conflit avec PG natif)
POSTGRES_LOCAL_DB=conx
POSTGRES_LOCAL_USER=conx
# IMPORTANT : changer en local. Pas commité.
POSTGRES_LOCAL_PASSWORD=changeme_local_only

# URL d'accès depuis le backend (au sein du réseau Docker)
DATABASE_URL_LOCAL=postgresql+asyncpg://conx:changeme_local_only@postgres_local:5432/conx

# ─────────────────────────────────────────────────────────
# Supabase Cloud (free tier) — Auth + tables app
# ─────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...           # clé publique anon (frontend OK)
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # clé admin backend uniquement, JAMAIS au frontend
SUPABASE_JWT_SECRET=...            # secret HS256 utilisé pour vérifier les JWT (cf. D-012)

# ─────────────────────────────────────────────────────────
# Anthropic Managed Agents
# ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Beta header — posé auto par le SDK, ici pour mémoire
ANTHROPIC_BETA=managed-agents-2026-04-01
# IDs des agents créés à J10 (remplis après création)
AGENT_SELECTION_ID=
AGENT_PLAN_ID=
AGENT_CONFORMITE_ID=
ENVIRONMENT_ID=

# ─────────────────────────────────────────────────────────
# Tunnel ngrok (démo + dev) — cf. D-013
# ─────────────────────────────────────────────────────────
# URL publique exposant le backend FastAPI aux agents Anthropic.
# Change à chaque démarrage de ngrok gratuit. Mise à jour via scripts/update_tunnel_url.py.
NGROK_PUBLIC_URL=https://YOUR_TUNNEL.ngrok-free.app

# ─────────────────────────────────────────────────────────
# Backend FastAPI
# ─────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Origins CORS autorisées (frontend dev + démo)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────
# Storage local (volume Docker)
# ─────────────────────────────────────────────────────────
DATA_STORAGE_PATH=/app/data/storage

# ─────────────────────────────────────────────────────────
# APIs publiques (pas de clé requise, ici pour mémoire)
# ─────────────────────────────────────────────────────────
BAN_API_URL=https://api-adresse.data.gouv.fr
IGN_WMTS_URL=https://data.geopf.fr/wmts

# ─────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
